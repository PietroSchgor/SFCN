{
    "cells": [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# Addestramento SFCN - Classificazione Binaria (Dataset OpenNeuro FCD)\n",
                "Questo notebook adatta l'architettura SFCN per un task di **classificazione binaria** anziché regressione dell'età.\n",
                "\n",
                "Il modello leggerà i file JSON associati a ciascun paziente per estrarre la label `"group"` (es. `hc` vs `fcd`) e predirrà a quale classe appartiene la risonanza magnetica."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "!rm -rf SFCN\n",
                "!git clone https://github.com/PietroSchgor/SFCN.git\n",
                "\n",
                "import sys\n",
                "sys.path.append('./SFCN')"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import os\n",
                "import json\n",
                "import glob\n",
                "import urllib.request\n",
                "import numpy as np\n",
                "import nibabel as nib\n",
                "import torch\n",
                "import torch.nn as nn\n",
                "import torch.optim as optim\n",
                "import matplotlib.pyplot as plt\n",
                "from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\n",
                "from sklearn.model_selection import train_test_split\n",
                "from sklearn.metrics import accuracy_score, roc_auc_score, confusion_matrix, classification_report\n",
                "import seaborn as sns\n",
                "\n",
                "from dp_model.model_files.sfcn import SFCN\n",
                "\n",
                "PLOTS_DIR = '/kaggle/working/plots'\n",
                "os.makedirs(PLOTS_DIR, exist_ok=True)\n",
                "MODELS_DIR = '/kaggle/working/models'\n",
                "os.makedirs(MODELS_DIR, exist_ok=True)"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 1. Configurazione Parametri"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "KAGGLE_DATA_DIR = \"/kaggle/input/datasets/collab4444/corrected_FCD_subject/corrected_FCD_subject\" # Aggiorna col path corretto\n",
                "MODALITY = \"t1w\" # Puoi scegliere \"t1w\" o \"flair\" in base ai file JSON\n",
                "\n",
                "# --- IMPOSTAZIONI TRAINING ---\n",
                "OUTPUT_DIM = 2  # Classificazione Binaria (es. HC vs FCD)\n",
                "EPOCHS = 100\n",
                "BATCH_SIZE = 4\n",
                "LR = 1e-4\n",
                "WEIGHT_DECAY = 1e-3\n",
                "PATIENCE = 15\n",
                "\n",
                "# --- IMPOSTAZIONI TRANSFER LEARNING ---\n",
                "USE_FINETUNING = True\n",
                "FREEZE_EARLY_LAYERS = False  # Full Fine-Tuning\n",
                "\n",
                "PRETRAINED_URL = \"https://raw.githubusercontent.com/ha-ha-ha-han/UKBiobank_deep_pretrain/master/brain_age/run_20190719_00_epoch_best_mae.p\"\n",
                "PRETRAINED_PATH = \"/kaggle/working/sfcn_official_pretrained.p\""
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 2. Dataloader per OpenNeuro (Estrazione Label da JSON)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "class OpenNeuroFCDDataset(Dataset):\n",
                "    def __init__(self, data_dir, modality=\"t1w\", is_train=False):\n",
                "        self.data_dir = data_dir\n",
                "        self.is_train = is_train\n",
                "        self.samples = []\n",
                "        \n",
                "        # Step 1: Trova tutti i folder dei soggetti\n",
                "        if not os.path.exists(data_dir):\n",
                "            print(f\"ATTENZIONE: Directory {data_dir} non trovata.\")\n",
                "            return\n",
                "            \n",
                "        subjects = [d for d in os.listdir(data_dir) if os.path.isdir(os.path.join(data_dir, d)) and d.startswith(\"sub-\")]\n",
                "        \n",
                "        # Step 2: Estrai i gruppi per mappare le classi (es. 'hc' -> 0, 'fcd' -> 1)\n",
                "        raw_samples = []\n",
                "        unique_groups = set()\n",
                "        \n",
                "        for sub in subjects:\n",
                "            json_path = os.path.join(data_dir, sub, f\"{sub}_participant_info.json\")\n",
                "            if not os.path.exists(json_path):\n",
                "                continue\n",
                "                \n",
                "            with open(json_path, 'r') as f:\n",
                "                info = json.load(f)\n",
                "                \n",
                "            try:\n",
                "                group = info['participant_info']['group'].lower()\n",
                "                nii_filename = info['image_files'][modality]\n",
                "                \n",
                "                if nii_filename is None:\n",
                "                    continue\n",
                "                    \n",
                "                nii_path = os.path.join(data_dir, sub, nii_filename)\n",
                "                if not os.path.exists(nii_path):\n",
                "                    continue\n",
                "                    \n",
                "                unique_groups.add(group)\n",
                "                raw_samples.append({\n",
                "                    'nii_path': nii_path,\n",
                "                    'group': group\n",
                "                    })\n",
                "            except KeyError:\n",
                "                continue\n",
                "                \n",
                "        # Step 3: Crea il mapping delle label (es. 'hc' = 0, altri = 1)\n",
                "        unique_groups = sorted(list(unique_groups))\n",
                "        self.class_map = {g: i for i, g in enumerate(unique_groups)}\n",
                "        print(f\"Mappatura Classi: {self.class_map}\")\n",
                "        \n",
                "        for s in raw_samples:\n",
                "            self.samples.append({\n",
                "                'nii_path': s['nii_path'],\n",
                "                'label': self.class_map[s['group']]\n",
                "            })\n",
                "            \n",
                "        print(f\"[{'TRAIN' if is_train else 'VAL/TEST'}] Caricati {len(self.samples)} pazienti validi.\")\n",
                "\n",
                "    def __len__(self):\n",
                "        return len(self.samples)\n",
                "\n",
                "    def __getitem__(self, idx):\n",
                "        sample = self.samples[idx]\n",
                "        img = nib.load(sample['nii_path'])\n",
                "        data = img.get_fdata(dtype=np.float32)\n",
                "        \n",
                "        mean_val = np.mean(data)\n",
                "        if mean_val > 0:\n",
                "            data = data / mean_val\n",
                "            \n",
                "        in_sp = data.shape\n",
                "        out_sp = (160, 192, 160)\n",
                "        \n",
                "        # Padding o Cropping\n",
                "        if self.is_train:\n",
                "            dx = np.random.randint(-3, 4)\n",
                "            dy = np.random.randint(-3, 4)\n",
                "            dz = np.random.randint(-3, 4)\n",
                "        else:\n",
                "            dx, dy, dz = 0, 0, 0\n",
                "            \n",
                "        x_c = int((in_sp[0] - out_sp[0]) / 2) + dx\n",
                "        y_c = int((in_sp[1] - out_sp[1]) / 2) + dy\n",
                "        z_c = int((in_sp[2] - out_sp[2]) / 2) + dz\n",
                "        \n",
                "        data = data[x_c:x_c+out_sp[0], y_c:y_c+out_sp[1], z_c:z_c+out_sp[2]]\n",
                "        \n",
                "        # Data Augmentation\n",
                "        if self.is_train and np.random.rand() > 0.5:\n",
                "            data = np.flip(data, axis=0).copy()\n",
                "            \n",
                "        data = np.expand_dims(data, axis=0) # Aggiunge channel dimension\n",
                "        \n",
                "        tensor_data = torch.from_numpy(data)\n",
                "        label = torch.tensor(sample['label'], dtype=torch.long) # CrossEntropyLoss richiede Long\n",
                "        \n",
                "        return tensor_data, label"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 3. Split Stratificato (70% Train, 15% Val, 15% Test)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
                "print(f\"Device in uso: {device}\")\n",
                "\n",
                "dummy_dataset = OpenNeuroFCDDataset(KAGGLE_DATA_DIR, modality=MODALITY, is_train=False)\n",
                "dataset_size = len(dummy_dataset)\n",
                "\n",
                "if dataset_size > 0:\n",
                "    all_labels = [sample['label'] for sample in dummy_dataset.samples]\n",
                "    all_indices = np.arange(dataset_size)\n",
                "    \n",
                "    # SPLIT 1: Train/Val (85%) e Test (15%)\n",
                "    tv_idx, test_idx, tv_labels, _ = train_test_split(\n",
                "        all_indices, all_labels, \n",
                "        test_size=0.15, random_state=42, stratify=all_labels\n",
                "    )\n",
                "    \n",
                "    # SPLIT 2: Dal 85% separiamo il Validation Set\n",
                "    train_idx, val_idx = train_test_split(\n",
                "        tv_idx, \n",
                "        test_size=0.176, random_state=42, stratify=tv_labels # 0.176 * 0.85 ≈ 0.15 totale\n",
                "    )\n",
                "    \n",
                "    print(f\"\\nSuddivisione Dataset:\")\n",
                "    print(f\"- Train Set: {len(train_idx)} pazienti\")\n",
                "    print(f\"- Validation Set: {len(val_idx)} pazienti\")\n",
                "    print(f\"- Test Set: {len(test_idx)} pazienti\")\n",
                "    \n",
                "    train_dataset = OpenNeuroFCDDataset(KAGGLE_DATA_DIR, modality=MODALITY, is_train=True)\n",
                "    val_dataset = OpenNeuroFCDDataset(KAGGLE_DATA_DIR, modality=MODALITY, is_train=False)\n",
                "    test_dataset = OpenNeuroFCDDataset(KAGGLE_DATA_DIR, modality=MODALITY, is_train=False)\n",
                "    \n",
                "    train_dataset = torch.utils.data.Subset(train_dataset, train_idx)\n",
                "    val_dataset = torch.utils.data.Subset(val_dataset, val_idx)\n",
                "    test_dataset = torch.utils.data.Subset(test_dataset, test_idx)\n",
                "    \n",
                "    # Sampler per sbilanciamento classi nel Train\n",
                "    train_labels = [all_labels[i] for i in train_idx]\n",
                "    class_counts = np.bincount(train_labels)\n",
                "    weights = [1.0 / class_counts[c] if class_counts[c] > 0 else 0 for c in train_labels]\n",
                "    sampler = WeightedRandomSampler(weights=weights, num_samples=len(weights), replacement=True)\n",
                "    \n",
                "    train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, sampler=sampler, num_workers=2)\n",
                "    val_loader = DataLoader(val_dataset, batch_size=1, shuffle=False, num_workers=2)\n",
                "    test_loader = DataLoader(test_dataset, batch_size=1, shuffle=False, num_workers=2)\n",
                "else:\n",
                "    print(\"ERRORE: Nessun file trovato.\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 4. Setup Modello e Ciclo di Addestramento per Classificazione"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "def load_pretrained_sfcn_binary(device, use_finetuning=True, freeze_early_layers=False):\n",
                "    model = SFCN(output_dim=OUTPUT_DIM) # OUTPUT_DIM = 2\n",
                "    if use_finetuning:\n",
                "        if not os.path.exists(PRETRAINED_PATH):\n",
                "            print(\"Scaricamento dei pesi ufficiali SFCN (UK Biobank)...\")\n",
                "            urllib.request.urlretrieve(PRETRAINED_URL, PRETRAINED_PATH)\n",
                "            \n",
                "        pretrained_state = torch.load(PRETRAINED_PATH, map_location='cpu')\n",
                "        clean_state = {k.replace(\"module.\", \"\"): v for k, v in pretrained_state.items()}\n",
                "        \n",
                "        # Rimuove il classificatore finale per adattarlo a 2 classi anziché 40\n",
                "        filtered_state = {k: v for k, v in clean_state.items() if not k.startswith('classifier.conv_6')}\n",
                "        model.load_state_dict(filtered_state, strict=False)\n",
                "        \n",
                "        if freeze_early_layers:\n",
                "            for name, param in model.named_parameters():\n",
                "                if any(name.startswith(f\"feature_extractor.conv_{i}\") for i in range(4)):\n",
                "                    param.requires_grad = False\n",
                "    \n",
                "    if torch.cuda.device_count() > 1:\n",
                "        model = nn.DataParallel(model)\n",
                "    model = model.to(device)\n",
                "    return model\n",
                "\n",
                "def train_binary_model(model, train_loader, val_loader, device):\n",
                "    criterion = nn.NLLLoss()\n",
                "    trainable_params = filter(lambda p: p.requires_grad, model.parameters())\n",
                "    optimizer = optim.Adam(trainable_params, lr=LR, weight_decay=WEIGHT_DECAY)\n",
                "    scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=30, gamma=0.3)\n",
                "    \n",
                "    best_val_loss = float('inf')\n",
                "    epochs_no_improve = 0\n",
                "    best_model_state = None\n",
                "    \n",
                "    train_losses, val_losses = [], []\n",
                "    \n",
                "    for epoch in range(EPOCHS):\n",
                "        model.train()\n",
                "        running_loss = 0.0\n",
                "        \n",
                "        for inputs, labels in train_loader:\n",
                "            inputs, labels = inputs.to(device), labels.to(device)\n",
                "            \n",
                "            optimizer.zero_grad()\n",
                "            outputs = model(inputs)\n",
                "            loss = criterion(outputs, labels)\n",
                "            loss.backward()\n",
                "            optimizer.step()\n",
                "            \n",
                "            running_loss += loss.item() * inputs.size(0)\n",
                "            \n",
                "        scheduler.step()\n",
                "        \n",
                "        epoch_train_loss = running_loss / len(train_loader.dataset)\n",
                "        train_losses.append(epoch_train_loss)\n",
                "        \n",
                "        # Validation\n",
                "        model.eval()\n",
                "        val_loss = 0.0\n",
                "        correct = 0\n",
                "        with torch.no_grad():\n",
                "            for inputs, labels in val_loader:\n",
                "                inputs, labels = inputs.to(device), labels.to(device)\n",
                "                outputs = model(inputs)\n",
                "                loss = criterion(outputs, labels)\n",
                "                val_loss += loss.item() * inputs.size(0)\n",
                "                \n",
                "                preds = torch.argmax(outputs, dim=1)\n",
                "                correct += (preds == labels).sum().item()\n",
                "                \n",
                "        epoch_val_loss = val_loss / len(val_loader.dataset)\n",
                "        val_acc = correct / len(val_loader.dataset)\n",
                "        val_losses.append(epoch_val_loss)\n",
                "        \n",
                "        print(f\"Epoch {epoch+1:03d}/{EPOCHS} | Train Loss: {epoch_train_loss:.4f} | Val Loss: {epoch_val_loss:.4f} | Val Acc: {val_acc:.4f}\")\n",
                "        \n",
                "        if epoch_val_loss < best_val_loss:\n",
                "            best_val_loss = epoch_val_loss\n",
                "            epochs_no_improve = 0\n",
                "            best_model_state = model.state_dict()\n",
                "        else:\n",
                "            epochs_no_improve += 1\n",
                "            if epochs_no_improve >= PATIENCE:\n",
                "                print(f\"\\nEarly stopping attivato all'epoca {epoch+1}!\")\n",
                "                break\n",
                "                \n",
                "    model.load_state_dict(best_model_state)\n",
                "    return model, train_losses, val_losses"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "if dataset_size > 0:\n",
                "    print(\"\\n==============================================\")\n",
                "    print(\" INIZIO ADDESTRAMENTO BINARIO SFCN\")\n",
                "    print(\"==============================================\")\n",
                "    \n",
                "    model = load_pretrained_sfcn_binary(device, USE_FINETUNING, FREEZE_EARLY_LAYERS)\n",
                "    best_model, t_losses, v_losses = train_binary_model(model, train_loader, val_loader, device)\n",
                "    \n",
                "    torch.save(best_model.state_dict(), os.path.join(MODELS_DIR, \"sfcn_openneuro_binary.pth\"))\n",
                "    \n",
                "    plt.figure(figsize=(8, 5))\n",
                "    plt.plot(t_losses, label='Train Loss', color='blue')\n",
                "    plt.plot(v_losses, label='Val Loss', color='orange')\n",
                "    plt.title('Curve di Apprendimento (CrossEntropyLoss)')\n",
                "    plt.xlabel('Epoca')\n",
                "    plt.ylabel('Loss')\n",
                "    plt.legend()\n",
                "    plt.grid(True)\n",
                "    plt.savefig(os.path.join(PLOTS_DIR, 'binary_learning_curve.png'))\n",
                "    plt.show()"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 5. Valutazione sul Test Set"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "if dataset_size > 0:\n",
                "    print(\"\\n==============================================\")\n",
                "    print(\" VALUTAZIONE SUL TEST SET\")\n",
                "    print(\"==============================================\")\n",
                "    \n",
                "    best_model.eval()\n",
                "    all_preds = []\n",
                "    all_probs = []\n",
                "    all_labels = []\n",
                "    \n",
                "    with torch.no_grad():\n",
                "        for inputs, labels in test_loader:\n",
                "            inputs, labels = inputs.to(device), labels.to(device)\n",
                "            outputs = best_model(inputs)\n",
                "            \n",
                "            probs = torch.exp(outputs)\n",
                "            preds = torch.argmax(probs, dim=1)\n",
                "            \n",
                "            all_probs.extend(probs[:, 1].cpu().numpy()) # Probabilità classe 1\n",
                "            all_preds.extend(preds.cpu().numpy())\n",
                "            all_labels.extend(labels.cpu().numpy())\n",
                "            \n",
                "    acc = accuracy_score(all_labels, all_preds)\n",
                "    \n",
                "    try:\n",
                "        auc = roc_auc_score(all_labels, all_probs)\n",
                "    except ValueError:\n",
                "        auc = float('nan') # Nel caso ci sia una sola classe nel test set\n",
                "        \n",
                "    cm = confusion_matrix(all_labels, all_preds)\n",
                "    \n",
                "    print(f\"\\n>>> ACCURACY: {acc:.4f}\")\n",
                "    print(f\">>> ROC-AUC : {auc:.4f}\")\n",
                "    \n",
                "    class_names = list(dummy_dataset.class_map.keys())\n",
                "    print(\"\\nClassification Report:\")\n",
                "    print(classification_report(all_labels, all_preds, target_names=class_names))\n",
                "    \n",
                "    # Plot Confusion Matrix\n",
                "    plt.figure(figsize=(6, 5))\n",
                "    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", xticklabels=class_names, yticklabels=class_names)\n",
                "    plt.title(\"Confusion Matrix - Test Set\", fontweight='bold', pad=15)\n",
                "    plt.xlabel(\"Predizione\")\n",
                "    plt.ylabel(\"Reale\")\n",
                "    plt.tight_layout()\n",
                "    plt.savefig(os.path.join(PLOTS_DIR, 'binary_confusion_matrix.png'), dpi=300)\n",
                "    plt.show()"
            ]
        }
    ],
